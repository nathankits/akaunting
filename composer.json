{
    "name": "akaunting/akaunting",
    "description": "Online accounting software built with Laravel",
    "homepage": "https://akaunting.com",
    "keywords": [
        "laravel",
        "accounting",
        "invoice",
        "expenses",
        "software",
        "online"
    ],
    "license": "BUSL-1.1",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-tokenizer": "*",
        "ext-xml": "*",
        "ext-zip": "*",
        "akaunting/laravel-apexcharts": "^4.0",
        "akaunting/laravel-debugbar-collector": "^2.1",
        "akaunting/laravel-firewall": "^3.0",
        "akaunting/laravel-language": "^1.0",
        "akaunting/laravel-menu": "*",
        "akaunting/laravel-module": "^4.0",
        "akaunting/laravel-money": "^6.0",
        "akaunting/laravel-mutable-observer": "*",
        "akaunting/laravel-setting": "^1.2",
        "akaunting/laravel-sortable": "^3.0",
        "akaunting/laravel-version": "^1.0",
        "akaunting/module-offline-payments": "^3.0",
        "akaunting/module-paypal-standard": "^3.0",
        "barryvdh/laravel-debugbar": "^4.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "barryvdh/laravel-ide-helper": "^3.7",
        "bkwld/cloner": "^3.15",
        "bugsnag/bugsnag-laravel": "^2.30",
        "doctrine/dbal": "^4.4",
        "genealabs/laravel-model-caching": "^13.1",
        "graham-campbell/markdown": "^16.1",
        "guzzlehttp/guzzle": "^7.9",
        "intervention/image": "^4.3",
        "laracasts/flash": "^3.2",
        "laravel/framework": "^13.29",
        "laravel/sanctum": "^4.3",
        "laravel/slack-notification-channel": "^3.10",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "league/flysystem-aws-s3-v3": "^3.35",
        "league/oauth2-client": "^2.9",
        "league/omnipay": "^3.2",
        "livewire/livewire": "^4.4",
        "lorisleiva/laravel-search-string": "*",
        "maatwebsite/excel": "^4.0",
        "mnsami/composer-custom-directory-installer": "^2.2",
        "plank/laravel-mediable": "^7.0",
        "riverskies/laravel-mobile-detect": "^1.3",
        "santigarcor/laratrust": "^8.5",
        "sentry/sentry-laravel": "^4.27",
        "simple-icons/simple-icons": "^16.29",
        "simshaun/recurr": "^6.0",
        "staudenmeir/belongs-to-through": "^2.18",
        "staudenmeir/eloquent-has-many-deep": "^1.22",
        "symfony/http-client": "^8.1",
        "symfony/mailgun-mailer": "^8.1",
        "symfony/postmark-mailer": "^8.1",
        "symfony/sendgrid-mailer": "^8.1"
    },
    "require-dev": {
        "brianium/paratest": "^7.24",
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.3",
        "spatie/laravel-ignition": "^2.12",
        "wnx/laravel-stats": "^2.20"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "installer-paths": {
            "modules/OfflinePayments": [
                "akaunting/module-offline-payments"
            ],
            "modules/PaypalStandard": [
                "akaunting/module-paypal-standard"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": [
                "app/"
            ],
            "Akaunting\\Module\\Commands\\": "overrides/akaunting/laravel-module/Commands/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeds\\": "database/seeds/",
            "Illuminate\\Translation\\": "overrides/Illuminate/Translation/",
            "Illuminate\\View\\Concerns\\": "overrides/Illuminate/View/Concerns/",
            "Livewire\\": "overrides/livewire/livewire/",
            "Maatwebsite\\Excel\\": "overrides/maatwebsite/excel/",
            "Modules\\": "modules/",
            "Symfony\\Component\\Process\\": "overrides/symfony/process/"
        },
        "exclude-from-classmap": [
            "vendor/akaunting/laravel-module/src/Commands/DeleteCommand.php",
            "vendor/akaunting/laravel-module/src/Commands/DisableCommand.php",
            "vendor/akaunting/laravel-module/src/Commands/EnableCommand.php",
            "vendor/akaunting/laravel-module/src/Commands/InstallCommand.php",
            "vendor/laravel/framework/src/Illuminate/Translation/MessageSelector.php",
            "vendor/laravel/framework/src/Illuminate/View/Concerns/ManagesStacks.php",
            "vendor/livewire/livewire/src/Mechanisms/HandleRequests/HandleRequests.php",
            "vendor/maatwebsite/excel/src/Fakes/ExcelFake.php",
            "vendor/maatwebsite/excel/src/QueuedWriter.php",
            "vendor/symfony/process/PhpExecutableFinder.php"
        ],
        "files": [
            "app/Utilities/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-install-cmd": [
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta",
            "php artisan ide-helper:models --nowrite"
        ],
        "post-update-cmd": [
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta",
            "php artisan ide-helper:models --nowrite"
        ],
        "post-create-project-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall",
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta"
        ],
        "prod": [
            "composer install --prefer-dist --no-interaction --no-scripts --no-progress --no-ansi --no-dev",
            "composer dump-autoload"
        ],
        "test": [
            "composer install --prefer-dist --no-interaction --no-scripts --no-progress --no-ansi",
            "composer dump-autoload"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/laravel-mutable-observer",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "packages/laravel-menu",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "packages/laravel-search-string",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "package",
            "package": {
                "name": "lcobucci/clock",
                "version": "3.0.0",
                "require": {
                    "php": "^8.1",
                    "psr/clock": "^1.0"
                },
                "provide": {
                    "psr/clock-implementation": "1.0"
                },
                "autoload": {
                    "psr-4": {
                        "Lcobucci\\Clock\\": "src"
                    }
                },
                "dist": {
                    "url": "https://api.github.com/repos/lcobucci/clock/zipball/039ef98c6b57b101d10bd11d8fdfda12cbd996dc",
                    "type": "zip"
                }
            }
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "mnsami/composer-custom-directory-installer": true,
            "php-http/discovery": true
        },
        "audit": {
            "block-insecure": false,
            "ignore": [
                "PKSA-y2cr-5h3j-g3ys",
                "PKSA-mdq4-51ck-6kdq",
                "PKSA-8qx3-n5y5-vvnd",
                "PKSA-w7xr-vk7n-rstm",
                "PKSA-q46n-4fdk-zjr4",
                "PKSA-qzrn-rnz3-85w1",
                "PKSA-dpt9-7cmv-dk65",
                "PKSA-3qhw-gzjt-j63j",
                "PKSA-17kp-jm2n-vxzz",
                "PKSA-p3rx-dfwp-73ny",
                "PKSA-7ywf-hktb-jkn9",
                "PKSA-ckwp-rt7t-c46m",
                "PKSA-4npr-btr6-zhny",
                "PKSA-njrm-6dtg-m2pc",
                "PKSA-vhvj-tvg4-96jj",
                "PKSA-nrj3-r2wg-yt8b",
                "PKSA-rvky-x3cg-y3qd",
                "PKSA-985r-hryy-555b",
                "PKSA-mhj3-vthf-h41n",
                "PKSA-cn77-7mny-v9zg",
                "PKSA-xf4x-p5c1-z9xq",
                "PKSA-fwj1-r2kg-bmxd"
            ]
        }
    }
}
