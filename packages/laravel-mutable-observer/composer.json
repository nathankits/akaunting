{
    "name": "akaunting/laravel-mutable-observer",
    "description": "Mutable observer package for Laravel",
    "keywords": [
        "laravel",
        "observer",
        "mutable",
        "mute",
        "unmute"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Denis Duli\u00e7i",
            "email": "info@akaunting.com",
            "homepage": "https://akaunting.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Akaunting\\MutableObserver\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Akaunting\\MutableObserver\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Akaunting\\MutableObserver\\Provider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "99.0.0"
}
